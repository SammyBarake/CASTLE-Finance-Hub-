# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Nothing is required to run the site locally: without these it uses .data/castle.json
# (from `npm run ingest -- --local`) or the built-in sample data.

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with a contact email on every request.
SEC_USER_AGENT="Castle research you@example.com"

# --- Supabase: website (read-only, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: ingest job only (full write access; NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: cache downloaded EDGAR documents on disk (speeds up local re-runs) ---
# EDGAR_CACHE_DIR=.data/cache

# --- Optional: make the local site read .data/castle.json even when Supabase keys are set ---
# CASTLE_DATA_SOURCE=local
