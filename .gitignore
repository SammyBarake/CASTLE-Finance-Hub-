# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
supabase/.temp/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js / build output ---
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# --- Testing ---
/coverage

# --- Vercel ---
.vercel

# --- Logs & OS ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

# --- Editors ---
.vscode/*
!.vscode/extensions.json
.idea

# --- Local scratch & ingest output ---
/.scratch/
/.data/
__pycache__/
